# Application
NODE_ENV=development
PORT=5000
API_PREFIX=/api/v1
CORS_ORIGIN=*
LOG_LEVEL=debug

# Database (PostgreSQL)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/mausam_db?schema=public"
DIRECT_URL="postgresql://postgres:postgres@localhost:5432/mausam_db?schema=public"

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_URL="redis://localhost:6379"

# JWT Authentication
JWT_SECRET=super_secret_jwt_access_key_replace_in_production_min_32_chars
JWT_REFRESH_SECRET=super_secret_jwt_refresh_key_replace_in_production_min_32_chars
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=1000

# Firebase Cloud Messaging
FIREBASE_PROJECT_ID=mausam-app-sih
FIREBASE_CLIENT_EMAIL=firebase-adminsdk@mausam-app-sih.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIEvgIBADANBgkqhkiG9w0BAQEFAASCBKgwggSkAgEAAoIBAQC...\n-----END PRIVATE KEY-----\n"

# External Weather & Environmental APIs (IMD, Open-Meteo, AQICN, OpenWeather, etc.)
IMD_API_BASE_URL=https://mausam.imd.gov.in/api
IMD_API_KEY=mock_imd_api_key
OPEN_METEO_BASE_URL=https://api.open-meteo.com/v1
OPEN_METEO_AIR_QUALITY_URL=https://air-quality-api.open-meteo.com/v1
WEATHER_API_KEY=demo_weather_api_key
AQI_API_KEY=demo_aqi_api_key
MAPS_API_KEY=demo_maps_api_key
MARINE_API_KEY=demo_marine_api_key
